{
  "openapi": "3.0.3",
  "info": {
    "title": "CH consumer authentication",
    "version": "rec-sso-03b-ch-v1"
  },
  "paths": {
    "/api/auth/login/": {
      "post": {
        "summary": "Start or complete central authentication",
        "description": "ISO Smart requires CSRF and returns HttpOnly cookies. MedSupplier returns bearer access/refresh. Challenge never grants a session. No local password fallback. CH requires CENTRAL RSA verification followed by authenticated live introspection; sessions are LOCAL RSA with a separate keyring. Historical tokens fail closed. This specification is not evidence of HTTP E2E.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "email",
                      "password"
                    ],
                    "properties": {
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "password": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "organization_id": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "challenge_token",
                      "otp_code"
                    ],
                    "properties": {
                      "challenge_token": {
                        "type": "string",
                        "writeOnly": true
                      },
                      "otp_code": {
                        "type": "string",
                        "writeOnly": true,
                        "description": "TOTP or backup code; only AdminApps verifies it"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pending central challenge or completed product session",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "requires_2fa",
                        "challenge_token",
                        "challenge_expires_in"
                      ],
                      "properties": {
                        "requires_2fa": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "challenge_token": {
                          "type": "string"
                        },
                        "challenge_expires_in": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "requires_2fa",
                        "user",
                        "profile",
                        "organizations"
                      ],
                      "properties": {
                        "requires_2fa": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "user": {
                          "type": "object"
                        },
                        "profile": {
                          "type": "object"
                        },
                        "organizations": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "access": {
                          "type": "string",
                          "description": "MedSupplier only"
                        },
                        "refresh": {
                          "type": "string",
                          "description": "MedSupplier only"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Central authentication, receiver, tenant, product or projection rejected"
          },
          "403": {
            "description": "ISO Smart CSRF validation rejected"
          },
          "503": {
            "description": "Central authority, configuration or schema unavailable; sanitized and terminal"
          }
        }
      }
    },
    "/api/auth/refresh/": {
      "post": {
        "summary": "Revalidate and renew the bound local session",
        "description": "ISO requires refresh cookie and CSRF; MedSupplier requires JSON refresh. Revalidates live authority, subject, tenant, product and role. Cannot exceed central access expiry. Old sessions are rejected. CH requires CENTRAL RSA verification followed by authenticated live introspection; sessions are LOCAL RSA with a separate keyring. Historical tokens fail closed. This specification is not evidence of HTTP E2E.",
        "responses": {
          "200": {
            "description": "Session renewed within central lifetime"
          },
          "401": {
            "description": "Reauthentication required"
          },
          "403": {
            "description": "CSRF rejected"
          },
          "503": {
            "description": "Authority unavailable"
          }
        }
      }
    },
    "/api/auth/switch-organization/": {
      "post": {
        "summary": "Switch only with central proof for target tenant",
        "description": "Requires current product session and central proof for target UUID. No cross-tenant rewriting; obtain new central authentication for another tenant. ISO also enforces CSRF.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "organization_id"
                ],
                "properties": {
                  "organization_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bound session issued"
          },
          "401": {
            "description": "Tenant/central proof rejected"
          },
          "403": {
            "description": "CSRF or permission denied"
          },
          "503": {
            "description": "Authority unavailable"
          }
        }
      }
    }
  }
}
