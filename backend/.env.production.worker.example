# Restricted outbox-worker identity. It intentionally lacks bootstrap/migrator secrets.
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
DB_NAME=isosmart_db
DB_HOST=database
DB_PORT=5432
DB_USER=isosmart_worker
DB_PASSWORD=replace-with-worker-secret
FOUNDATION_DB_NAME=isosmart_db
FOUNDATION_DB_HOST=database
FOUNDATION_DB_PORT=5432
FOUNDATION_WORKER_ROLE=isosmart_worker
FOUNDATION_WORKER_PASSWORD=replace-with-worker-secret
WORKER_TENANT_ID=replace-with-trusted-tenant-uuid
INTERNAL_OUTBOX_WORKER_ENABLED=True
