# Restricted web runtime identity. It intentionally lacks bootstrap/migrator secrets.
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=isosmart.example.com
CSRF_TRUSTED_ORIGINS=https://isosmart.example.com
CORS_ALLOWED_ORIGINS=https://isosmart.example.com
DB_NAME=isosmart_db
DB_HOST=database
DB_PORT=5432
DB_USER=isosmart_app
DB_PASSWORD=replace-with-app-secret
FOUNDATION_DB_NAME=isosmart_db
FOUNDATION_DB_HOST=database
FOUNDATION_DB_PORT=5432
FOUNDATION_APP_ROLE=isosmart_app
FOUNDATION_APP_PASSWORD=replace-with-app-secret
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
ADMIN_APPS_BASE_URL=https://adminapps.example.com/api/integration
ADMIN_APPS_API_KEY=replace-with-secret
ALLOW_LOCAL_AUTH_FALLBACK=False
ALLOW_LOCAL_AUTH_BYPASS_FOR_TESTS=False
