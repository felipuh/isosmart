# Used only by the Django migration job; never grant it to web or worker.
DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
DB_NAME=isosmart_db
DB_HOST=database
DB_PORT=5432
DB_USER=isosmart_migrator
DB_PASSWORD=replace-with-migrator-secret
FOUNDATION_DB_NAME=isosmart_db
FOUNDATION_DB_HOST=database
FOUNDATION_DB_PORT=5432
FOUNDATION_MIGRATOR_ROLE=isosmart_migrator
FOUNDATION_APP_ROLE=isosmart_app
FOUNDATION_WORKER_ROLE=isosmart_worker
FOUNDATION_PROJECTOR_ROLE=isosmart_projector
FOUNDATION_AUDIT_WRITER_ROLE=isosmart_audit_writer
FOUNDATION_NORMATIVE_CURATOR_ROLE=isosmart_normative_curator
FOUNDATION_AGENT_CATALOG_CURATOR_ROLE=isosmart_agent_catalog_curator
FOUNDATION_HUMAN_APPROVER_ROLE=isosmart_human_approver
FOUNDATION_EXECUTION_AUTHORIZER_ROLE=isosmart_execution_authorizer
FOUNDATION_EXECUTOR_ROLE=isosmart_executor
FOUNDATION_LEARNING_GOVERNANCE_ROLE=isosmart_learning_governance
FOUNDATION_LEARNING_REVIEWER_ROLE=isosmart_learning_reviewer
FOUNDATION_LEARNING_APPROVER_ROLE=isosmart_learning_approver
FOUNDATION_LEARNING_AUTHORIZER_ROLE=isosmart_learning_authorizer
FOUNDATION_LEARNING_APPLICATION_EXECUTOR_ROLE=isosmart_learning_application_executor
FOUNDATION_RULE_PUBLISHER_ROLE=isosmart_rule_publisher
FOUNDATION_RULE_ACTIVATOR_ROLE=isosmart_rule_activator
