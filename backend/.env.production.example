DJANGO_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=isosmart.example.com
CSRF_TRUSTED_ORIGINS=https://isosmart.example.com
CORS_ALLOWED_ORIGINS=https://isosmart.example.com

# PostgreSQL image initialization is the canonical database credential
# contract. Django reads these same values when DB_* aliases are omitted.
POSTGRES_DB=isosmart_db
POSTGRES_USER=isosmart_user
POSTGRES_PASSWORD=replace-with-secret
DB_HOST=127.0.0.1
DB_PORT=5432

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

ADMIN_APPS_BASE_URL=https://adminapps.example.com/api/integration
ADMIN_APPS_API_KEY=replace-with-secret
ALLOW_LOCAL_AUTH_FALLBACK=False
ALLOW_LOCAL_AUTH_BYPASS_FOR_TESTS=False
WORKER_TENANT_ID=replace-with-trusted-tenant-uuid
INTERNAL_OUTBOX_WORKER_ENABLED=True
BACKUP_DESTINATION=/var/lib/isosmart/backups
# Commands are supplied by the platform KMS/encryption integration, never by source.
BACKUP_ENCRYPTION_COMMAND=replace-with-approved-encryption-command
BACKUP_DECRYPTION_COMMAND=replace-with-approved-decryption-command
