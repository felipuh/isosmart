# ===============================
# ISO Smart Backend Environment
# ===============================

# Core Django
DJANGO_ENV=
DEBUG=
SECRET_KEY=
SMART3AI_SSO_JWT_SECRET=
SMART3AI_SSO_ISSUER=
SMART3AI_SSO_AUDIENCE=
ALLOWED_HOSTS=

# For production:
# DJANGO_ENV=production
# DEBUG=False
# SECRET_KEY=<set-a-secure-random-value>

# Primary database
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# AI database (optional override)
AI_DB_NAME=
AI_DB_USER=
AI_DB_PASSWORD=
AI_DB_HOST=
AI_DB_PORT=

# Audit database (optional override)
AUDIT_DB_NAME=
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=
AUDIT_DB_HOST=
AUDIT_DB_PORT=

# AdminApps integration
ADMIN_APPS_BASE_URL=
ADMIN_APPS_API_KEY=
ADMIN_APPS_TIMEOUT=
ADMIN_APPS_CACHE_TTL=
ADMIN_APPS_SYNC_USERS=
ISO_SMART_PRODUCT_CODE=
# Local/demo fallback when AdminApps rejects unavailable seeded credentials.
# Local auth bypass is only honored when DJANGO_ENV=development.
ALLOW_LOCAL_AUTH_BYPASS_FOR_TESTS=
LOCAL_AUTH_BYPASS_HOSTS=

# Browser/API security
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
THROTTLE_ANON_RATE=
THROTTLE_USER_RATE=

# AI Assistant provider (OpenAI-compatible)
AI_ASSISTANT_API_URL=
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_MODEL=
AI_ASSISTANT_SUPPORTED_STANDARDS=
AI_ASSISTANT_SYSTEM_PROMPT=

# Production-like example overrides
#
# DJANGO_ENV=production
# DEBUG=False
# SECRET_KEY=replace_with_long_random_secret_from_secret_manager
# ALLOWED_HOSTS=isosmart.smart3ai.local,isosmart.isosmart.local
# CORS_ALLOWED_ORIGINS=https://isosmart.smart3ai.local
# CSRF_TRUSTED_ORIGINS=https://isosmart.smart3ai.local
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# ALLOW_LOCAL_AUTH_BYPASS_FOR_TESTS=False
